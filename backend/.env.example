# Serveur
PORT=5000
NODE_ENV=development

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=talentproof
DB_USER=postgres
DB_PASSWORD=your_password

# JWT
JWT_SECRET=change_this_secret_key_in_production
JWT_EXPIRES_IN=7d

# Stockage vidéo / documents (Cloudflare R2 ou AWS S3)
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_BUCKET=talentproof-media
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_REGION=auto

# OTP (SMS via Africa's Talking ou Twilio)
OTP_PROVIDER=africastalking
OTP_API_KEY=your_otp_key
OTP_SENDER=TalentProof
